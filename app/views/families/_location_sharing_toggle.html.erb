<%= turbo_frame_tag "location-sharing-#{member.id}" do %>
  <div data-controller="location-sharing-toggle"
       data-location-sharing-toggle-member-id-value="<%= member.id %>"
       data-location-sharing-toggle-enabled-value="<%= membership.sharing_active? %>"
       data-location-sharing-toggle-expires-at-value="<%= membership.sharing_expires_at&.iso8601 %>">

    <%= form_with url: family_location_sharing_path(family),
                  method: :patch,
                  data: {
                    turbo_frame: "location-sharing-#{member.id}",
                    location_sharing_toggle_target: "form"
                  } do |f| %>

      <%# Hidden fields %>
      <%= f.hidden_field :enabled,
            value: membership.sharing_active? ? "true" : "false",
            data: { location_sharing_toggle_target: "enabledField" } %>
      <%= f.hidden_field :duration,
            value: membership.sharing_duration_label,
            data: { location_sharing_toggle_target: "durationField" } %>
      <%= f.hidden_field :share_history,
            value: membership.share_history? ? "true" : "false",
            data: { location_sharing_toggle_target: "shareHistoryField" } %>
      <%= f.hidden_field :history_window,
            value: membership.history_window,
            data: { location_sharing_toggle_target: "historyWindowField" } %>

      <div class="grid grid-cols-[auto_auto_1fr] items-center gap-x-3 gap-y-2">

        <%# Row 1: Live location %>
        <span class="text-sm text-base-content/60 text-right whitespace-nowrap"><%= t('.live_location') %></span>

        <input type="checkbox"
               class="toggle toggle-primary toggle-md"
               <%= 'checked' if membership.sharing_active? %>
               data-location-sharing-toggle-target="checkbox"
               data-action="change->location-sharing-toggle#toggle">

        <div class="flex items-center gap-2">
          <div class="<%= 'hidden' unless membership.sharing_active? %>"
               data-location-sharing-toggle-target="durationContainer">
            <select class="select select-bordered select-md"
                    data-location-sharing-toggle-target="durationSelect"
                    data-action="change->location-sharing-toggle#changeDuration">
              <option value="permanent" <%= 'selected' if membership.sharing_duration_label == 'permanent' %>><%= t('.always') %></option>
              <option value="1h" <%= 'selected' if membership.sharing_duration_label == '1h' %>><%= t('.hour') %></option>
              <option value="6h" <%= 'selected' if membership.sharing_duration_label == '6h' %>><%= t('.hours') %></option>
              <option value="12h" <%= 'selected' if membership.sharing_duration_label == '12h' %>><%= t('.hours_2') %></option>
              <option value="24h" <%= 'selected' if membership.sharing_duration_label == '24h' %>><%= t('.hours_3') %></option>
            </select>
          </div>

          <% if membership.sharing_active? && membership.sharing_expires_at.present? %>
            <span class="text-xs text-base-content/50"
                  data-location-sharing-toggle-target="expirationInfo">
              <%= t('.expires_in_time', time: relative_distance_in_words(membership.sharing_expires_at)) %>
            </span>
          <% else %>
            <span class="text-xs text-base-content/50 hidden"
                  data-location-sharing-toggle-target="expirationInfo">
            </span>
          <% end %>
        </div>

        <%# Row 2: Location history (only visible when live sharing is enabled) %>
        <template data-location-sharing-toggle-target="historyRow">
        </template>

        <div class="<%= 'hidden' unless membership.sharing_active? %> contents"
             data-location-sharing-toggle-target="historyContainer">

          <span class="text-sm text-base-content/60 text-right whitespace-nowrap"><%= t('.location_history') %></span>

          <input type="checkbox"
                 class="toggle toggle-secondary toggle-md"
                 <%= 'checked' if membership.share_history? %>
                 data-location-sharing-toggle-target="historyCheckbox"
                 data-action="change->location-sharing-toggle#toggleHistory">

          <div class="<%= 'hidden' unless membership.share_history? %>"
               data-location-sharing-toggle-target="historyWindowContainer">
            <select class="select select-bordered select-md"
                    data-location-sharing-toggle-target="historyWindowSelect"
                    data-action="change->location-sharing-toggle#changeHistoryWindow">
              <option value="24h" <%= 'selected' if membership.history_window == '24h' %>><%= t('.last_24_hours') %></option>
              <option value="7d" <%= 'selected' if membership.history_window == '7d' %>><%= t('.last_7_days') %></option>
              <option value="30d" <%= 'selected' if membership.history_window == '30d' %>><%= t('.last_30_days') %></option>
              <option value="all" <%= 'selected' if membership.history_window == 'all' %>><%= t('.since_sharing_started') %></option>
            </select>
          </div>

          <p class="col-span-full text-xs text-base-content/50 leading-snug">
            <%= t('.a_separate_setting_from_live_location_when_on_family_can') %>
          </p>

        </div>

      </div>
    <% end %>
  </div>
<% end %>
