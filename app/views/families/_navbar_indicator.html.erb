<%= turbo_frame_tag "family-navbar-indicator" do %>
  <% sharing = user.in_family? && user.family_memberships.any?(&:sharing_active?) %>
  <div data-controller="family-navbar-indicator"
       data-family-navbar-indicator-enabled-value="<%= sharing %>">
    <div data-family-navbar-indicator-target="indicator"
         class="tooltip tooltip-bottom w-2 h-2 <%= sharing ? 'bg-green-500 animate-pulse' : 'bg-gray-400' %> rounded-full"
         data-tip="<%= t(sharing ? '.location_shared' : '.location_not_shared') %>">
    </div>
  </div>
<% end %>
